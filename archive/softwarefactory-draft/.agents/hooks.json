{
  "pre-impl-design-audit-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/design_audit_gate.py --event PreToolUse",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./scripts/design_audit_gate.py --event Stop",
        "timeout": 10
      }
    ]
  }
}
